{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "icons/android-chrome-192x192.png",
          "icons/android-chrome-512x512.png"
        ]
      }
    },
    {
      "name": "local-audio",
      "installMode": "lazy", 
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/audio/hadith/**/*.mpeg",
          "/audio/hadith/**/*.mp3"
        ]
      }
    }
  ],
"dataGroups": [
    {
      "name": "api-audio",
      "urls": [
        "https://www.everyayah.com/data/Ayman_Sowaid_64kbps/**"
      ],
      "cacheConfig": {
        "maxSize": 150,        
        "maxAge": "30d",        
        "timeout": "5s",
        "strategy": "performance"
      }
    }
  ]
}