{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
       "files": [
          "/assets/**/*",
          "/icons/**/*",
          "/fonts/**/*"
        ]
      }
    },{
      "name": "game-assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/images/play-images/**/*",
          "/audio/play-game/**/*"
        ]
      }
    },
    {
      "name": "ryad-assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/images/ryad/**/*",
           "/images/nawawi/**/*"
        ]
      }
    },{
      "name": "local-audio",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/audio/hadith/**/*.mpeg",
          "/audio/hadith/**/*.mp3",
          "/audio/hadith/**/*.m4a",
          "/audio/ryad-bab-1/**/*.m4a",
          "/audio/ryad-bab-1/**/*.mp3",
          "/audio/ryad-bab-1/**/*.mpeg",
          "/audio/ryad-bab-2/**/*.m4a",
          "/audio/ryad-bab-2/**/*.mp3",
          "/audio/ryad-bab-2/**/*.mpeg"
        ]
      },
"cacheQueryOptions": {
        "ignoreSearch": true
      }
    }
  ],"dataGroups": [
    {
      "name": "api-audio",
      "urls": [
        "https://www.everyayah.com/data/Ayman_Sowaid_64kbps/**"
      ],
      "cacheConfig": {
        "maxSize": 150,
        "maxAge": "30d",
        "timeout": "5s",
        "strategy": "performance"
      }
    }
  ]

}
