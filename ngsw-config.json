{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "game-assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/android-chrome-192x192.png",
          "/icons/android-chrome-512x512.png",
          "/images/play-images/**",
          "/audio/play-game/**"
        ]
      }
    },
    {
      "name": "local-audio",
      "installMode": "prefetch", 
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/audio/hadith/**/*.mpeg",
          "/audio/hadith/**/*.mp3",
          "/audio/hadith/**/*.m4a",
          "/audio/ryad-bab-1/**/*.m4a",
          "/audio/ryad-bab-1/**/*.mp3",
          "/audio/ryad-bab-1/**/*.mpeg"
        ]
      },
      "cacheQueryOptions": {
        "ignoreSearch": true
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-audio",
      "urls": [
        "https://www.everyayah.com/data/Ayman_Sowaid_64kbps/**"
      ],
      "cacheConfig": {
        "maxSize": 150,        
        "maxAge": "30d",        
        "timeout": "5s",
        "strategy": "performance"
      }
    }
  ]
}